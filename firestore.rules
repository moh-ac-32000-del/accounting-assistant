rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function workspacePath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }

    function memberPath(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid);
    }

    function isActiveMember(workspaceId, uid) {
      return signedIn()
        && exists(memberPath(workspaceId, uid))
        && get(memberPath(workspaceId, uid)).data.uid == uid
        && get(memberPath(workspaceId, uid)).data.status == "active";
    }

    function isCurrentUserMember(workspaceId) {
      return isActiveMember(workspaceId, request.auth.uid);
    }

    function isActiveMemberAfter(workspaceId, uid) {
      return signedIn()
        && existsAfter(memberPath(workspaceId, uid))
        && getAfter(memberPath(workspaceId, uid)).data.uid == uid
        && getAfter(memberPath(workspaceId, uid)).data.status == "active";
    }

    function isOwner(workspaceId) {
      return isCurrentUserMember(workspaceId)
        && get(memberPath(workspaceId, request.auth.uid)).data.role == "owner";
    }

    function validRole(role) {
      return role in ["owner", "admin", "staff"];
    }

    function validMemberStatus(status) {
      return status in ["active", "suspended"];
    }

    match /users/{userId} {
      allow read: if signedIn()
        && request.auth.uid == userId;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.activeWorkspaceId is string
        && existsAfter(workspacePath(request.resource.data.activeWorkspaceId))
        && getAfter(workspacePath(request.resource.data.activeWorkspaceId)).data.ownerUid == userId
        && getAfter(workspacePath(request.resource.data.activeWorkspaceId)).data.status == "active"
        && existsAfter(memberPath(request.resource.data.activeWorkspaceId, userId))
        && getAfter(memberPath(request.resource.data.activeWorkspaceId, userId)).data.uid == userId
        && getAfter(memberPath(request.resource.data.activeWorkspaceId, userId)).data.role == "owner"
        && getAfter(memberPath(request.resource.data.activeWorkspaceId, userId)).data.status == "active"
        && getAfter(memberPath(request.resource.data.activeWorkspaceId, userId)).data.schemaVersion == 1;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeWorkspaceId", "updatedAt"])
        && request.resource.data.activeWorkspaceId is string
        && (
          request.resource.data.activeWorkspaceId == resource.data.activeWorkspaceId
          || isActiveMemberAfter(request.resource.data.activeWorkspaceId, userId)
        );

      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow create: if signedIn()
        && request.resource.data.schemaVersion == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "active"
        && existsAfter(memberPath(workspaceId, request.auth.uid))
        && getAfter(memberPath(workspaceId, request.auth.uid)).data.uid == request.auth.uid
        && getAfter(memberPath(workspaceId, request.auth.uid)).data.role == "owner"
        && getAfter(memberPath(workspaceId, request.auth.uid)).data.status == "active"
        && getAfter(memberPath(workspaceId, request.auth.uid)).data.schemaVersion == 1
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.activeWorkspaceId == workspaceId;

      allow read: if isCurrentUserMember(workspaceId);

      allow update: if isOwner(workspaceId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "updatedAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isCurrentUserMember(workspaceId);

        allow create: if signedIn()
          && memberUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == "owner"
          && request.resource.data.status == "active"
          && request.resource.data.schemaVersion == 1
          && existsAfter(workspacePath(workspaceId))
          && getAfter(workspacePath(workspaceId)).data.ownerUid == request.auth.uid
          && getAfter(workspacePath(workspaceId)).data.status == "active"
          && existsAfter(userPath(request.auth.uid))
          && getAfter(userPath(request.auth.uid)).data.uid == request.auth.uid
          && getAfter(userPath(request.auth.uid)).data.activeWorkspaceId == workspaceId;

        allow update: if isOwner(workspaceId)
          && memberUid != request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.schemaVersion == resource.schemaVersion
          && validRole(request.resource.data.role)
          && validMemberStatus(request.resource.data.status)
          && request.resource.data.role != "owner"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "status"]);

        allow delete: if false;
      }
    }

    match /workspaces/{workspaceId}/customers/{customerId} {
      allow read: if isCurrentUserMember(workspaceId);

      allow create: if isCurrentUserMember(workspaceId)
        && request.resource.data.schemaVersion == 1
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.notes is string
        && request.resource.data.status == "active"
        && request.resource.data.createdByUid == request.auth.uid;

      allow update: if isCurrentUserMember(workspaceId)
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.notes is string
        && request.resource.data.status in ["active", "archived"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "phone",
          "address",
          "notes",
          "status",
          "updatedByUid",
          "updatedAt"
        ])
        && request.resource.data.updatedByUid == request.auth.uid;

      allow delete: if false;
    }

    match /workspaces/{workspaceId}/storeProfile/{profileId} {
      allow read: if isCurrentUserMember(workspaceId);

      allow create: if isCurrentUserMember(workspaceId)
        && profileId == "profile"
        && get(memberPath(workspaceId, request.auth.uid)).data.role in ["owner", "admin"]
        && request.resource.data.schemaVersion == 1
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.currency in ["TRY", "USD"]
        && request.resource.data.language in ["ar", "tr", "en"];

      allow update: if isCurrentUserMember(workspaceId)
        && profileId == "profile"
        && get(memberPath(workspaceId, request.auth.uid)).data.role in ["owner", "admin"]
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.currency in ["TRY", "USD"]
        && request.resource.data.language in ["ar", "tr", "en"];

      allow delete: if false;
    }

    match /workspaces/{workspaceId}/debts/{debtId} {
      allow read: if isCurrentUserMember(workspaceId);
      allow create, update, delete: if false;
    }

    match /workspaces/{workspaceId}/cashBalances/{currency} {
      allow read: if isCurrentUserMember(workspaceId);
      allow create, update, delete: if false;
    }

    match /workspaces/{workspaceId}/cashMovements/{movementId} {
      allow read: if isCurrentUserMember(workspaceId);
      allow create, update, delete: if false;
    }

    match /workspaces/{workspaceId}/payments/{paymentId} {
      allow read: if isCurrentUserMember(workspaceId);
      allow create, update, delete: if false;
    }

    match /workspaces/{workspaceId}/auditEvents/{eventId} {
      allow read: if isCurrentUserMember(workspaceId)
        && get(memberPath(workspaceId, request.auth.uid)).data.role in ["owner", "admin"];
      allow create, update, delete: if false;
    }

    match /workspaces/{workspaceId}/reminders/{reminderId} {
      allow read: if isCurrentUserMember(workspaceId);
      allow create, update, delete: if false;
    }

    match /workspaces/{workspaceId}/archive/{archiveId} {
      allow read: if isCurrentUserMember(workspaceId);
      allow create, update, delete: if false;
    }

    match /workspaces/{workspaceId}/dailyClosings/{closingId} {
      allow read: if isCurrentUserMember(workspaceId);
      allow create, update, delete: if false;
    }

    match /workspaces/{workspaceId}/journalEntries/{entryId} {
      allow read: if isCurrentUserMember(workspaceId);
      allow create, update, delete: if false;
    }

    match /workspaces/{workspaceId}/operationReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}